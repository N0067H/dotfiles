// Niri session alongside the existing Hyprland session.
input {
    keyboard {
        xkb {
            layout "us"
            options "korean:ralt_hangul,caps:ctrl_modifier"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

cursor {
    xcursor-theme "BreezeX-RosePine-Linux"
    xcursor-size 22
}

layout {
    gaps 12
    default-column-width { proportion 0.5; }
    focus-ring { off; }
    border {
        on
        width 1
        active-gradient from="#8dbfd5" to="#86bdb9" angle=45
        inactive-color "#435b70"
    }
}

// Round both the compositor border and the actual window surface together.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

spawn-at-startup "noctalia"
// Let the Wayland session finish initializing before Fcitx connects to it.
spawn-at-startup "sh" "-c" "sleep 3; exec fcitx5 -r -D"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+T hotkey-overlay-title="Open terminal: Kitty" { spawn "kitty"; }
    Mod+B hotkey-overlay-title="Open Firefox" { spawn "firefox"; }
    Ctrl+B hotkey-overlay-title="Fullscreen window" { fullscreen-window; }
    Mod+D hotkey-overlay-title="Open app launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+Comma hotkey-overlay-title="Noctalia settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+E hotkey-overlay-title="Open files" { spawn "nautilus"; }
    Mod+Shift+V hotkey-overlay-title="Clipboard history" { spawn-sh "cliphist list | rofi -dmenu | cliphist decode | wl-copy"; }
    Mod+Q hotkey-overlay-title="Close window" { close-window; }
    Mod+Shift+E hotkey-overlay-title="Exit Niri" { quit; }
    Mod+Shift+L hotkey-overlay-title="Lock screen" { spawn "swaylock"; }
    Mod+Shift+P hotkey-overlay-title="Display layout" { spawn "/home/noobth/dev/dotfiles/niri/scripts/display-menu.sh"; }
    Mod+Ctrl+Shift+P hotkey-overlay-title="Restore laptop display" { spawn "/home/noobth/dev/dotfiles/niri/scripts/display-menu.sh" "--recover"; }

    Mod+H hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+J hotkey-overlay-title="Focus window down" { focus-window-down; }
    Mod+K hotkey-overlay-title="Focus window up" { focus-window-up; }
    Mod+L hotkey-overlay-title="Focus column right" { focus-column-right; }
    Mod+Ctrl+H hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+Ctrl+J hotkey-overlay-title="Move window down" { move-window-down; }
    Mod+Ctrl+K hotkey-overlay-title="Move window up" { move-window-up; }
    Mod+Ctrl+L hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+BracketLeft hotkey-overlay-title="Join or split window to the left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Join or split window to the right" { consume-or-expel-window-right; }
    Mod+Comma hotkey-overlay-title="Stack next window in this column" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="Split window into a new column" { expel-window-from-column; }
    Mod+U hotkey-overlay-title="Workspace down" { focus-workspace-down; }
    Mod+I hotkey-overlay-title="Workspace up" { focus-workspace-up; }
    Mod+Ctrl+U hotkey-overlay-title="Move column to workspace down" { move-column-to-workspace-down; }
    Mod+Ctrl+I hotkey-overlay-title="Move column to workspace up" { move-column-to-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Scroll to workspace down" { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 hotkey-overlay-title="Scroll to workspace up" { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Scroll right through columns" { focus-column-right; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 hotkey-overlay-title="Scroll left through columns" { focus-column-left; }
    Mod+R hotkey-overlay-title="Change column width" { switch-preset-column-width; }
    Mod+F hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen window" { fullscreen-window; }
    Mod+Space hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    Mod+O hotkey-overlay-title="Toggle overview" { toggle-overview; }

    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "+10%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
    Print { screenshot; }
}
