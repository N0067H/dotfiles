// Niri session alongside the existing Hyprland session.
input {
    keyboard { xkb { layout "us"; } }
    touchpad { tap; natural-scroll; }
}

layout {
    gaps 12
    default-column-width { proportion 0.5; }
    focus-ring { width 2; active-color "#7fc8ff"; }
}

spawn-at-startup "waybar" "-c" "/home/noobth/dev/dotfiles/niri/waybar.jsonc" "-s" "/home/noobth/dev/dotfiles/waybar/style.css"
spawn-at-startup "swaync"
spawn-at-startup "nm-applet"
spawn-at-startup "swaybg" "-i" "/home/noobth/dev/dotfiles/hypr/wallpapers/ayu-night.png" "-m" "fill"

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "rofi" "-show" "drun"; }
    Mod+E { spawn "nautilus"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+L { spawn "swaylock"; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Space { toggle-window-floating; }
    Mod+O { toggle-overview; }

    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "+10%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
    Print { screenshot; }
}
